# ---- Local mock shop ----
MOCK_SHOP_PORT=4173

# ---- Browser layer ----
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
HEADLESS=true
# Which browser Playwright drives: msedge | chrome | (blank = Playwright's own Chromium)
BROWSER_CHANNEL=

# auto = use SAM if SAM_API_URL and SAM_API_KEY are set, otherwise fall back to the DOM | sam | dom
DISCOVERY_MODE=auto

# ---- Meta Model API (one key serves both SAM and Muse Spark) ----
# Paste the key you created at dev.meta.ai -> API keys. NEVER share it or commit this file.
MODEL_API_KEY=

# ---- Phase 3: SAM 3.1 (endpoint and model already default to Meta's official values) ----
SAM_API_URL=https://api.meta.ai/v1/responses
SAM_MODEL=sam-3.1
# SAM takes ONE noun phrase per request. Each item below becomes its own request.
SAM_CONCEPTS=button,input field

# ---- Phase 4: Muse Spark ----
# muse-spark-1.2 = Standard tier. The '-contributor' variant is cheaper BUT your prompts may be used to train Meta models.
MUSE_API_URL=https://api.meta.ai/v1/responses
MUSE_MODEL=muse-spark-1.2
# Time limits (milliseconds) and automatic retries for slow or flaky network calls
MUSE_TIMEOUT_MS=150000
MUSE_RETRIES=2
SAM_TIMEOUT_MS=90000
SAM_RETRIES=2
# Optional experiment: ask Muse to think less so it answers faster (low | medium | high). Leave blank by default.
MUSE_REASONING_EFFORT=
